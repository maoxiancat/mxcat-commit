#!/bin/sh
# 只读标准输入上的提交消息。不创建 commit，不读固定路径。
set -eu

awk '
BEGIN {
  header_ok = 0
  line_no = 0
  seen_blank = 0
  body_nonempty = 0
  after_nonempty = 0
  forbidden = 0
}
{
  sub(/\r$/, "")
  line_no++
  if (line_no == 1) {
    if ($0 ~ /^:[a-z0-9_+-]+: \([^)[:space:]]+\)( !)? .+/) header_ok = 1
  } else {
    if ($0 ~ /./) after_nonempty = 1
    if (!seen_blank) {
      if ($0 == "") seen_blank = 1
    } else if ($0 ~ /./) {
      body_nonempty = 1
    }
  }
  lower = tolower($0)
  if (lower ~ /^(ai-co-authored-by:|co-authored-by:|jira-refs:)/) forbidden = 1
}
END {
  code = 0
  if (!header_ok) {
    print "validate: header 不合格" > "/dev/stderr"
    code = 1
  }
  if (forbidden) {
    print "validate: 含有禁止页脚" > "/dev/stderr"
    code = 1
  }
  if (after_nonempty && !body_nonempty) {
    print "validate: 标题与正文之间缺少空行" > "/dev/stderr"
    code = 1
  }
  exit code
}
'
