#!/bin/sh
# 覆盖 commit_one 换入时的类型、模式，以及重复 diff 头。
set -eu

skill=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
commit_one=$skill/scripts/commit_one

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

msg=':bug: (demo) 记下一次改动'

new_repo() {
  repo=$(mktemp -d)
  git -C "$repo" init -q
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
}

commit_msg() {
  printf '%s\n' "$msg" | (cd "$repo" && "$commit_one" "$@")
}

# 同一路径两段 diff --git：只提交前两处，第三处留在工作区。
new_repo
printf 'a\n\n\n\n\n\n\n\n\nb\n\n\n\n\n\n\n\n\nc\n' > "$repo/f.txt"
git -C "$repo" add f.txt
git -C "$repo" commit -q -m 'base'
printf 'A\n\n\n\n\n\n\n\n\nB\n\n\n\n\n\n\n\n\nC\n' > "$repo/f.txt"
git -C "$repo" diff -- f.txt > "$repo/full.patch"
awk '
  /^diff --git / { header = $0; next }
  /^index / { next }
  /^--- / { old = $0; next }
  /^\+\+\+ / { new = $0; next }
  /^@@ / {
    if (hunk != "") {
      print header
      print old
      print new
      print hunk
    }
    hunk = $0
    next
  }
  { hunk = hunk "\n" $0 }
  END {
    if (hunk != "") {
      print header
      print old
      print new
      print hunk
    }
  }
' "$repo/full.patch" > "$repo/all.patch"
# 丢掉最后一段（C），前两段各自带 diff 头。
awk '
  /^diff --git / { n++ }
  n < 3 { print }
' "$repo/all.patch" > "$repo/two.patch"
set +e
out=$(commit_msg --hunks "$repo/two.patch" -- f.txt 2>&1)
code=$?
set -e
if [ "$code" -ne 0 ]; then
  echo "$out" >&2
  fail "两段头提交失败: $code"
fi
git -C "$repo" show HEAD:f.txt > "$repo/show.txt"
printf 'A\n\n\n\n\n\n\n\n\nB\n\n\n\n\n\n\n\n\nc\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "两段头: commit 内容不对"
printf 'A\n\n\n\n\n\n\n\n\nB\n\n\n\n\n\n\n\n\nC\n' > "$repo/work-expect.txt"
cmp -s "$repo/f.txt" "$repo/work-expect.txt" || fail "两段头: 未选中的 C 从工作区消失"
echo "ok 两段 diff 头保留未选中 hunk"

# index 120000，工作区已是普通文件。
new_repo
printf 'target\n' > "$repo/b"
ln -s b "$repo/link"
git -C "$repo" add b link
git -C "$repo" commit -q -m 'base'
rm "$repo/link"
ln -s elsewhere "$repo/link"
git -C "$repo" add link
rm "$repo/link"
printf 'plain\n' > "$repo/link"
before=$(cksum "$repo/link")
commit_msg -- link
gotmode=$(git -C "$repo" ls-tree HEAD link | awk '{print $1}')
[ "$gotmode" = 120000 ] || fail "符号链接: commit 模式 $gotmode"
target=$(git -C "$repo" cat-file blob HEAD:link)
[ "$target" = elsewhere ] || fail "符号链接: 目标 $target"
[ -f "$repo/link" ] && [ ! -L "$repo/link" ] || fail "符号链接: 工作区应恢复为普通文件"
after=$(cksum "$repo/link")
[ "$before" = "$after" ] || fail "符号链接: 工作区内容变了"
echo "ok 暂存符号链接且工作区是普通文件"

# index 100755，工作区文件已删除。
new_repo
printf '#!/bin/sh\necho hi\n' > "$repo/run.sh"
chmod 755 "$repo/run.sh"
git -C "$repo" add run.sh
git -C "$repo" commit -q -m 'base'
printf '#!/bin/sh\necho yo\n' > "$repo/run.sh"
chmod 755 "$repo/run.sh"
git -C "$repo" add run.sh
rm "$repo/run.sh"
commit_msg -- run.sh
gotmode=$(git -C "$repo" ls-tree HEAD run.sh | awk '{print $1}')
[ "$gotmode" = 100755 ] || fail "删除后的可执行位: $gotmode"
[ ! -e "$repo/run.sh" ] || fail "删除后的可执行位: 工作区不该有文件"
echo "ok 工作区删除后仍提交 100755"

# 工作区 644，index 755，内容还有未暂存改动。
new_repo
printf 'old\n' > "$repo/run.sh"
git -C "$repo" add run.sh
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/run.sh"
chmod 755 "$repo/run.sh"
git -C "$repo" add run.sh
printf 'staged\nwork\n' > "$repo/run.sh"
chmod 644 "$repo/run.sh"
commit_msg -- run.sh
gotmode=$(git -C "$repo" ls-tree HEAD run.sh | awk '{print $1}')
[ "$gotmode" = 100755 ] || fail "工作区 644: commit 模式 $gotmode"
body=$(git -C "$repo" show HEAD:run.sh)
[ "$body" = 'staged' ] || fail "工作区 644: commit 内容被未暂存改动污染"
now=$(stat -f '%OLp' "$repo/run.sh")
[ "$now" = 644 ] || fail "工作区 644: 恢复后模式 $now"
grep -q work "$repo/run.sh" || fail "工作区 644: 未暂存内容丢了"
echo "ok 工作区 644 时 commit 仍是 100755"

# 只暂存可执行位，blob 与 HEAD 相同，工作区另有内容。
new_repo
printf 'same\n' > "$repo/run.sh"
git -C "$repo" add run.sh
git -C "$repo" commit -q -m 'base'
chmod 755 "$repo/run.sh"
git -C "$repo" add run.sh
printf 'same\nextra\n' > "$repo/run.sh"
commit_msg -- run.sh
gotmode=$(git -C "$repo" ls-tree HEAD run.sh | awk '{print $1}')
[ "$gotmode" = 100755 ] || fail "只改模式: $gotmode"
body=$(git -C "$repo" show HEAD:run.sh)
[ "$body" = same ] || fail "只改模式: 内容被带进 commit"
grep -q extra "$repo/run.sh" || fail "只改模式: 工作区内容丢了"
echo "ok 只暂存可执行位"

# 链接两边目标不一致，不改目标文件。
new_repo
printf 'A\n' > "$repo/a"
printf 'B\n' > "$repo/b"
ln -s a "$repo/link"
git -C "$repo" add a b link
git -C "$repo" commit -q -m 'base'
rm "$repo/link"
ln -s b "$repo/link"
git -C "$repo" add link
rm "$repo/link"
ln -s a "$repo/link"
suma=$(cksum "$repo/a")
sumb=$(cksum "$repo/b")
commit_msg -- link
gotmode=$(git -C "$repo" ls-tree HEAD link | awk '{print $1}')
[ "$gotmode" = 120000 ] || fail "目标不一致: 模式 $gotmode"
target=$(git -C "$repo" cat-file blob HEAD:link)
[ "$target" = b ] || fail "目标不一致: commit 目标 $target"
[ "$(cksum "$repo/a")" = "$suma" ] || fail "目标不一致: 文件 a 被改"
[ "$(cksum "$repo/b")" = "$sumb" ] || fail "目标不一致: 文件 b 被改"
[ -L "$repo/link" ] || fail "目标不一致: 工作区不再是链接"
[ "$(readlink "$repo/link")" = a ] || fail "目标不一致: 工作区链接变了"
echo "ok 符号链接目标不一致"

# 悬空符号链接。
new_repo
printf 'x\n' > "$repo/f.txt"
ln -s missing "$repo/link"
git -C "$repo" add f.txt link
git -C "$repo" commit -q -m 'base'
rm "$repo/link"
ln -s other-missing "$repo/link"
git -C "$repo" add link
rm "$repo/link"
ln -s missing "$repo/link"
commit_msg -- link
gotmode=$(git -C "$repo" ls-tree HEAD link | awk '{print $1}')
[ "$gotmode" = 120000 ] || fail "悬空链接: 模式 $gotmode"
target=$(git -C "$repo" cat-file blob HEAD:link)
[ "$target" = other-missing ] || fail "悬空链接: 目标 $target"
[ ! -e "$repo/other-missing" ] || fail "悬空链接: 创建了目标"
[ -L "$repo/link" ] || fail "悬空链接: 工作区不是链接"
[ "$(readlink "$repo/link")" = missing ] || fail "悬空链接: 工作区链接变了"
echo "ok 悬空符号链接"

echo "all ok"
