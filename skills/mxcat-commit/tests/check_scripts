#!/bin/sh
# 覆盖 --add 同一路径两种写法、已暂存删除、删除后又出现的文件，以及改名旧路径。
set -eu

skill=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
commit_one=$skill/scripts/commit_one

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

msg=':bug: (demo) 记下一次改动'

new_repo() {
  repo=$(mktemp -d)
  git -C "$repo" init -q
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
}

commit_msg() {
  _dir=$1
  shift
  printf '%s\n' "$msg" | (cd "$_dir" && "$commit_one" "$@")
}

# ./note.txt 与 note.txt：index 与工作区不一致时，commit 只含 index。
new_repo
printf 'base\n' > "$repo/note.txt"
git -C "$repo" add note.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/note.txt"
git -C "$repo" add note.txt
printf 'staged\nextra\n' > "$repo/note.txt"
commit_msg "$repo" --add -- ./note.txt note.txt
git -C "$repo" show HEAD:note.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "两种写法: commit 不是 index"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/note.txt" "$repo/work.txt" || fail "两种写法: 未暂存内容从工作区消失"
echo "ok --add 同一路径两种写法"

# 重复参数，但 index 与 HEAD 相同：仍提交工作区全文。
new_repo
printf 'base\n' > "$repo/note.txt"
git -C "$repo" add note.txt
git -C "$repo" commit -q -m 'base'
printf 'work\n' > "$repo/note.txt"
commit_msg "$repo" --add -- ./note.txt note.txt
git -C "$repo" show HEAD:note.txt > "$repo/show.txt"
printf 'work\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "重复参数: commit 不是工作区全文"
echo "ok --add 重复参数仍提交全文"

# 已暂存的删除可以 --add。
new_repo
printf 'base\n' > "$repo/gone.txt"
git -C "$repo" add gone.txt
git -C "$repo" commit -q -m 'base'
git -C "$repo" rm -q gone.txt
commit_msg "$repo" --add -- gone.txt
git -C "$repo" cat-file -e HEAD:gone.txt 2>/dev/null && fail "已暂存删除: commit 仍有该文件"
echo "ok 已暂存删除可以 --add"

# 工作区已删、尚未暂存：--add 纳入删除。
new_repo
printf 'base\n' > "$repo/gone.txt"
git -C "$repo" add gone.txt
git -C "$repo" commit -q -m 'base'
rm "$repo/gone.txt"
commit_msg "$repo" --add -- gone.txt
git -C "$repo" cat-file -e HEAD:gone.txt 2>/dev/null && fail "未暂存删除: commit 仍有该文件"
echo "ok 未暂存删除由 --add 纳入"

# 删除已暂存，文件又出现：带与不带 --add 都提交删除，工作区留下。
for flag in --add ''; do
  new_repo
  printf 'base\n' > "$repo/gone.txt"
  git -C "$repo" add gone.txt
  git -C "$repo" commit -q -m 'base'
  git -C "$repo" rm -q gone.txt
  printf 'back\n' > "$repo/gone.txt"
  if [ "$flag" = --add ]; then
    commit_msg "$repo" --add -- gone.txt
  else
    commit_msg "$repo" -- gone.txt
  fi
  git -C "$repo" cat-file -e HEAD:gone.txt 2>/dev/null && fail "删除后又出现 $flag: 新文件进了 commit"
  printf 'back\n' > "$repo/expect.txt"
  cmp -s "$repo/gone.txt" "$repo/expect.txt" || fail "删除后又出现 $flag: 工作区没有放回"
done
echo "ok 删除后又出现仍提交删除"

# 挪走之后、创建 commit 之前失败：文件回到调用前。
new_repo
printf 'base\n' > "$repo/gone.txt"
printf 'keep\n' > "$repo/other.txt"
git -C "$repo" add gone.txt other.txt
git -C "$repo" commit -q -m 'base'
git -C "$repo" rm -q gone.txt
printf 'back\n' > "$repo/gone.txt"
mkdir -p "$repo/.git/hooks"
printf '#!/bin/sh\nexit 1\n' > "$repo/.git/hooks/pre-commit"
chmod +x "$repo/.git/hooks/pre-commit"
set +e
commit_msg "$repo" --add -- gone.txt >/dev/null 2>&1
code=$?
set -e
[ "$code" -ne 0 ] || fail "提交前失败: 退出码是 0"
git -C "$repo" rev-parse --verify HEAD^ >/dev/null 2>&1 && fail "提交前失败: 产生了新 commit"
printf 'back\n' > "$repo/expect.txt"
cmp -s "$repo/gone.txt" "$repo/expect.txt" || fail "提交前失败: 工作区文件没有放回"
echo "ok 提交前失败放回后出现的文件"

# 相似度下降后，--add 两个路径提交删除加新增。
new_repo
printf 'alpha beta gamma delta epsilon\n' > "$repo/old.txt"
git -C "$repo" add old.txt
git -C "$repo" commit -q -m 'base'
git -C "$repo" mv old.txt new.txt
printf 'zzzz unrelated payload 000111222333444555\n' > "$repo/new.txt"
git -C "$repo" add new.txt
status=$(git -C "$repo" -c core.quotePath=false diff --cached --name-status -M HEAD)
printf '%s\n' "$status" | grep -q '^R' && fail "相似度用例仍被识别为 rename: $status"
commit_msg "$repo" --add -- old.txt new.txt
git -C "$repo" cat-file -e HEAD:old.txt 2>/dev/null && fail "相似度下降: commit 仍有旧路径"
git -C "$repo" show HEAD:new.txt > "$repo/show.txt"
printf 'zzzz unrelated payload 000111222333444555\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "相似度下降: 新路径不是暂存内容"
echo "ok 相似度下降后 --add 两个路径"

# 仍是 rename 时，只给旧路径要在 commit 前退出。
for flag in --add ''; do
  new_repo
  printf 'same\n' > "$repo/old.txt"
  git -C "$repo" add old.txt
  git -C "$repo" commit -q -m 'base'
  git -C "$repo" mv old.txt new.txt
  head_before=$(git -C "$repo" rev-parse HEAD)
  set +e
  if [ "$flag" = --add ]; then
    commit_msg "$repo" --add -- old.txt >/dev/null 2>&1
  else
    commit_msg "$repo" -- old.txt >/dev/null 2>&1
  fi
  code=$?
  set -e
  [ "$code" -ne 0 ] || fail "只给旧路径 $flag: 退出码是 0"
  [ "$(git -C "$repo" rev-parse HEAD)" = "$head_before" ] || fail "只给旧路径 $flag: 产生了 commit"
  cached=$(git -C "$repo" -c core.quotePath=false diff --cached --name-status -M HEAD)
  printf '%s\n' "$cached" | grep -q '^R' || fail "只给旧路径 $flag: index 不再是改名: $cached"
done
echo "ok 只给 rename 旧路径在提交前退出"

# 相似度不足时只给旧路径，仍提交删除，新路径留在 index。
new_repo
printf 'alpha beta gamma delta epsilon\n' > "$repo/old.txt"
git -C "$repo" add old.txt
git -C "$repo" commit -q -m 'base'
git -C "$repo" mv old.txt new.txt
printf 'zzzz unrelated payload 000111222333444555\n' > "$repo/new.txt"
git -C "$repo" add new.txt
commit_msg "$repo" --add -- old.txt
git -C "$repo" cat-file -e HEAD:old.txt 2>/dev/null && fail "只给旧路径: commit 仍有旧路径"
git -C "$repo" diff --cached --name-only HEAD -- new.txt | grep -qx new.txt || fail "只给旧路径: 新路径没有留在 index"
echo "ok 相似度不足时只给旧路径仍提交删除"

# copy 的旧路径有未暂存改动：--add 只提交 index。
new_repo
printf 'base\n' > "$repo/old.txt"
git -C "$repo" add old.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/old.txt"
git -C "$repo" add old.txt
cp "$repo/old.txt" "$repo/new.txt"
git -C "$repo" add new.txt
printf 'staged\nextra\n' > "$repo/old.txt"
commit_msg "$repo" --add -- old.txt
git -C "$repo" show HEAD:old.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "copy 旧路径: commit 含未暂存内容"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/old.txt" "$repo/work.txt" || fail "copy 旧路径: 未暂存内容从工作区消失"
echo "ok copy 旧路径不按 rename 跳过"
