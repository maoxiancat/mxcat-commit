#!/bin/sh
# 覆盖同一路径两种写法、hunks 旁路的已暂存文件，以及子目录中的换入。
set -eu

skill=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
commit_one=$skill/scripts/commit_one

fail() {
  echo "FAIL: $*" >&2
  exit 1
}

msg=':bug: (demo) 记下一次改动'

new_repo() {
  repo=$(mktemp -d)
  git -C "$repo" init -q
  git -C "$repo" config user.name Test
  git -C "$repo" config user.email test@example.com
}

commit_msg() {
  _dir=$1
  shift
  printf '%s\n' "$msg" | (cd "$_dir" && "$commit_one" "$@")
}

# 把 full.diff 拆成每段自带 diff 头，再只留前 n 段。
first_hunks() {
  _full=$1
  _out=$2
  _n=$3
  awk -v keep="$_n" '
    /^diff --git / { header = $0; next }
    /^index / { next }
    /^--- / { old = $0; next }
    /^\+\+\+ / { new = $0; next }
    /^@@ / {
      if (hunk != "") {
        n++
        if (n <= keep) {
          print header
          print old
          print new
          print hunk
        }
      }
      hunk = $0
      next
    }
    { hunk = hunk "\n" $0 }
    END {
      if (hunk != "") {
        n++
        if (n <= keep) {
          print header
          print old
          print new
          print hunk
        }
      }
    }
  ' "$_full" > "$_out"
}

# ./f.txt 与 f.txt：commit 只含 index，未暂存内容留在工作区。
new_repo
printf 'base\n' > "$repo/f.txt"
git -C "$repo" add f.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/f.txt"
git -C "$repo" add f.txt
printf 'staged\nextra\n' > "$repo/f.txt"
commit_msg "$repo" -- ./f.txt f.txt
git -C "$repo" show HEAD:f.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "两种写法: commit 不是 index"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/f.txt" "$repo/work.txt" || fail "两种写法: 未暂存内容从工作区消失"
echo "ok 同一路径两种写法"

# --hunks 提交 a.txt 第一段，c.txt 只提交 index。
new_repo
printf 'a\n\n\n\n\n\n\n\n\nb\n' > "$repo/a.txt"
printf 'base\n' > "$repo/c.txt"
git -C "$repo" add a.txt c.txt
git -C "$repo" commit -q -m 'base'
printf 'A\n\n\n\n\n\n\n\n\nB\n' > "$repo/a.txt"
printf 'C\n' > "$repo/c.txt"
git -C "$repo" add c.txt
printf 'C\nextra\n' > "$repo/c.txt"
git -C "$repo" diff -- a.txt > "$repo/a.diff"
first_hunks "$repo/a.diff" "$repo/one.patch" 1
commit_msg "$repo" --hunks "$repo/one.patch" -- a.txt c.txt
git -C "$repo" show HEAD:a.txt > "$repo/show-a.txt"
printf 'A\n\n\n\n\n\n\n\n\nb\n' > "$repo/expect-a.txt"
cmp -s "$repo/show-a.txt" "$repo/expect-a.txt" || fail "旁路: a.txt commit 不是选中 hunk"
printf 'A\n\n\n\n\n\n\n\n\nB\n' > "$repo/work-a.txt"
cmp -s "$repo/a.txt" "$repo/work-a.txt" || fail "旁路: a.txt 未选 hunk 从工作区消失"
git -C "$repo" show HEAD:c.txt > "$repo/show-c.txt"
printf 'C\n' > "$repo/expect-c.txt"
cmp -s "$repo/show-c.txt" "$repo/expect-c.txt" || fail "旁路: c.txt commit 含未暂存内容"
printf 'C\nextra\n' > "$repo/work-c.txt"
cmp -s "$repo/c.txt" "$repo/work-c.txt" || fail "旁路: c.txt 未暂存内容从工作区消失"
echo "ok hunks 旁路只提交 index"

# c.txt 的 index 与 HEAD 相同，工作区有未暂存改动：提交前退出。
new_repo
printf 'a\n\n\n\n\n\n\n\n\nb\n' > "$repo/a.txt"
printf 'C\n' > "$repo/c.txt"
git -C "$repo" add a.txt c.txt
git -C "$repo" commit -q -m 'base'
head_before=$(git -C "$repo" rev-parse HEAD)
printf 'A\n\n\n\n\n\n\n\n\nB\n' > "$repo/a.txt"
printf 'C\nextra\n' > "$repo/c.txt"
git -C "$repo" diff -- a.txt > "$repo/a.diff"
first_hunks "$repo/a.diff" "$repo/one.patch" 1
set +e
out=$(commit_msg "$repo" --hunks "$repo/one.patch" -- a.txt c.txt 2>&1)
code=$?
set -e
[ "$code" -ne 0 ] || fail "index 与 HEAD 相同: 不该创建 commit"
printf '%s\n' "$out" | grep -q '没有可提交的已暂存改动' || fail "index 与 HEAD 相同: 退出说明不对"
[ "$(git -C "$repo" rev-parse HEAD)" = "$head_before" ] || fail "index 与 HEAD 相同: HEAD 被移动"
echo "ok hunks 旁路无已暂存改动时提交前退出"

# 子目录：只提交已暂存内容。
new_repo
mkdir "$repo/sub"
printf 'base\n' > "$repo/sub/f.txt"
git -C "$repo" add sub/f.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/sub/f.txt"
git -C "$repo" add sub/f.txt
printf 'staged\nextra\n' > "$repo/sub/f.txt"
commit_msg "$repo/sub" -- f.txt
git -C "$repo" show HEAD:sub/f.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "子目录暂存: commit 不是 index"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/sub/f.txt" "$repo/work.txt" || fail "子目录暂存: 未暂存内容从工作区消失"
echo "ok 子目录只提交已暂存内容"

# 子目录：--hunks 是完整 hunk 子集。
new_repo
mkdir "$repo/sub"
printf 'a\n\n\n\n\n\n\n\n\nb\n' > "$repo/sub/f.txt"
git -C "$repo" add sub/f.txt
git -C "$repo" commit -q -m 'base'
printf 'A\n\n\n\n\n\n\n\n\nB\n' > "$repo/sub/f.txt"
git -C "$repo" diff -- sub/f.txt > "$repo/full.diff"
first_hunks "$repo/full.diff" "$repo/one.patch" 1
commit_msg "$repo/sub" --hunks "$repo/one.patch" -- f.txt
git -C "$repo" show HEAD:sub/f.txt > "$repo/show.txt"
printf 'A\n\n\n\n\n\n\n\n\nb\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "子目录 hunks: commit 不是选中 hunk"
printf 'A\n\n\n\n\n\n\n\n\nB\n' > "$repo/work.txt"
cmp -s "$repo/sub/f.txt" "$repo/work.txt" || fail "子目录 hunks: 未选 hunk 从工作区消失"
echo "ok 子目录按 hunk 提交"

# --add 只提交已暂存的一截，未暂存内容留下。
new_repo
printf 'base\n' > "$repo/note.txt"
git -C "$repo" add note.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/note.txt"
git -C "$repo" add note.txt
printf 'staged\nextra\n' > "$repo/note.txt"
commit_msg "$repo" --add -- note.txt
git -C "$repo" show HEAD:note.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "部分暂存 --add: commit 不是 index"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/note.txt" "$repo/work.txt" || fail "部分暂存 --add: 未暂存内容从工作区消失"
echo "ok --add 只提交已暂存的一截"

# index 与 HEAD 相同时，--add 提交工作区全文。
new_repo
printf 'base\n' > "$repo/note.txt"
git -C "$repo" add note.txt
git -C "$repo" commit -q -m 'base'
printf 'full\n' > "$repo/note.txt"
commit_msg "$repo" --add -- note.txt
git -C "$repo" show HEAD:note.txt > "$repo/show.txt"
printf 'full\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "仅工作区 --add: commit 不是工作区全文"
echo "ok --add 提交仅存在于工作区的全文"

# 尚未进入 index 的文件，--add 提交工作区全文。
new_repo
printf 'base\n' > "$repo/keep.txt"
git -C "$repo" add keep.txt
git -C "$repo" commit -q -m 'base'
printf 'new\n' > "$repo/fresh.txt"
commit_msg "$repo" --add -- fresh.txt
git -C "$repo" show HEAD:fresh.txt > "$repo/show.txt"
printf 'new\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "未跟踪 --add: commit 不是工作区全文"
echo "ok --add 提交尚未进入 index 的全文"

# 已暂存的改名可以 --add 旧路径和新路径。
new_repo
printf 'body\n' > "$repo/old.txt"
git -C "$repo" add old.txt
git -C "$repo" commit -q -m 'base'
git -C "$repo" mv old.txt new.txt
commit_msg "$repo" --add -- old.txt new.txt
status=$(git -C "$repo" -c core.quotePath=false show --name-status --pretty=format: HEAD)
printf '%s\n' "$status" | grep -q '^R' || fail "已暂存改名 --add: 不是 rename"
echo "ok 已暂存改名可以 --add"

# 工作区已改名、尚未暂存时，--add 两个路径仍是一次 rename。
new_repo
printf 'body\n' > "$repo/old.txt"
git -C "$repo" add old.txt
git -C "$repo" commit -q -m 'base'
mv "$repo/old.txt" "$repo/new.txt"
commit_msg "$repo" --add -- old.txt new.txt
status=$(git -C "$repo" -c core.quotePath=false show --name-status --pretty=format: HEAD)
printf '%s\n' "$status" | grep -q '^R' || fail "未暂存改名 --add: 不是 rename"
echo "ok 未暂存改名可以 --add"

# 不带 --add 时，部分暂存仍只提交 index。
new_repo
printf 'base\n' > "$repo/note.txt"
git -C "$repo" add note.txt
git -C "$repo" commit -q -m 'base'
printf 'staged\n' > "$repo/note.txt"
git -C "$repo" add note.txt
printf 'staged\nextra\n' > "$repo/note.txt"
commit_msg "$repo" -- note.txt
git -C "$repo" show HEAD:note.txt > "$repo/show.txt"
printf 'staged\n' > "$repo/expect.txt"
cmp -s "$repo/show.txt" "$repo/expect.txt" || fail "不带 --add: commit 不是 index"
printf 'staged\nextra\n' > "$repo/work.txt"
cmp -s "$repo/note.txt" "$repo/work.txt" || fail "不带 --add: 未暂存内容从工作区消失"
echo "ok 不带 --add 仍只提交 index"
